# PostgreSQL connection string (Neon, Supabase, RDS, Railway, Render, etc.)
# Local: postgresql://postgres:postgres@127.0.0.1:5432/app_db
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Import desk passcode for /admin. Change this before going live.
ADMIN_PASSCODE=bandari2026

# Optional: signs the admin session cookie. Set to a long random string.
ADMIN_SECRET=change-me-to-a-long-random-string
